new file mode 100644
index 0000000000..3e3fca34ab
--- /dev/null
+++ b/superset-frontend/plugins/plugin-chart-benchmark-range/src/PluginChartBenchmarkRange.tsx
@@ -0,0 +1,632 @@
+/**
